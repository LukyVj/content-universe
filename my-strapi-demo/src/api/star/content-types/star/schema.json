{
  "kind": "collectionType",
  "collectionName": "stars",
  "info": {
    "singularName": "star",
    "pluralName": "stars",
    "displayName": "star"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "color": {
      "type": "string",
      "regex": "^#[0-9a-fA-F]{6}$"
    },
    "radius": {
      "type": "decimal"
    },
    "x": {
      "type": "decimal"
    },
    "z": {
      "type": "decimal"
    },
    "constellations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::constellation.constellation",
      "mappedBy": "stars"
    },
    "planets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::planet.planet",
      "mappedBy": "star"
    }
  }
}
